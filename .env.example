# Papyrus base URL (no trailing slash, no /api/v1).
PAPYRUS_URL=http://papyrus.lan:8000
# Papyrus: Settings -> API Tokens. Permissions: print + scan
# (add email / files if scan "send to" email/SMB/cloud/paperless is used).
PAPYRUS_TOKEN=

# Label maker base URL on the server (not the Pi bridge).
LABELMAKER_URL=http://labelmaker.lan:8000
# Label maker: Settings -> API keys (lm_...), scope: write.
# Required only if the app uses AUTH_MODE=oidc; leave empty with AUTH_MODE=none.
LABELMAKER_TOKEN=

# Minutes of inactivity before the backlight turns off.
IDLE_MINUTES=5

# Backlight device: `ls /sys/class/backlight` (host/setup.sh detects it)
BACKLIGHT_DEVICE=10-0045

# Scan "send to" destinations shown on the scan screen.
SCAN_PAPERLESS=true
# SMB share id (Papyrus) and subfolder; empty disables.
SCAN_SMB_SHARE_ID=
SCAN_SMB_PATH=
# Cloud provider id; empty disables.
SCAN_CLOUD_PROVIDER_ID=
# Email recipient; empty disables.
SCAN_EMAIL_TO=

# Image tags (latest or a pinned version).
KIOSK_TAG=latest
LABELMAKER_TAG=latest
