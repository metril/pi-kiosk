# Papyrus base URL (no trailing slash, no /api/v1).
PAPYRUS_URL=http://papyrus.lan:8000
# Papyrus: Settings -> API Tokens. Permissions: print, scan, device only.
# Send-to, files and email use a per-user token minted by the phone unlock
# (device grant, requires Papyrus 1.5.0 or newer).
PAPYRUS_TOKEN=

# Pi address the label-maker bridge (:9177, mTLS) listens on; the label app must reach it.
# Required, set to the Pi's LAN IP (never 0.0.0.0). Use 127.0.0.1 if the label app is on this Pi.
BRIDGE_BIND=

# Label maker base URL on the server (not the Pi bridge).
LABELMAKER_URL=http://labelmaker.lan:8000
# Label maker: Settings -> API keys (lm_...), scope: write.
# Required only if the app uses AUTH_MODE=oidc; leave empty with AUTH_MODE=none.
LABELMAKER_TOKEN=

# Minutes of inactivity before the backlight turns off.
IDLE_MINUTES=5

# Backlight device: `ls /sys/class/backlight` (host/setup.sh detects it)
BACKLIGHT_DEVICE=10-0045

# Scan "send to" destinations shown on the scan screen.
SCAN_PAPERLESS=true
# SMB share id (Papyrus) and subfolder; empty disables.
SCAN_SMB_SHARE_ID=
SCAN_SMB_PATH=
# Cloud provider id; empty disables.
SCAN_CLOUD_PROVIDER_ID=
# Email recipient; only used if it matches a KIOSK_CONTACTS email. Empty disables.
SCAN_EMAIL_TO=

# Phone QR unlock (Papyrus device grant). Idle timeout and max session, seconds.
UNLOCK_IDLE_S=120
UNLOCK_MAX_S=900
# Remote-print spool (disk-backed dir) and size cap
# SPOOL_DIR=/var/tmp
# PRINT_MAX_BYTES=104857600
# Browser-reachable Papyrus URL used in QR codes (e.g. https://<papyrus-host>); empty keeps Papyrus's own URL.
PAPYRUS_PUBLIC_URL=
# Email goes only to these (JSON): [{"id":"a","name":"Alice","email":"alice@example.com"}]
KIOSK_CONTACTS=
# Scan presets (JSON): [{"id":"p","label":"To share","icon":"folder","post":{"ocr":true},
#   "targets":[{"type":"smb","share_id":"1","path":"/in"},{"type":"paperless"},{"type":"email","contact_id":"a"}]}]
# SCAN_* above stay as an implicit "default" preset.
KIOSK_PRESETS=

# Home Assistant via MQTT discovery; empty MQTT_HOST disables it.
# MQTT_HOST=
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TLS=false
# Optional CA bundle (path inside the container) to verify the broker; hostname check on.
# MQTT_CA_FILE=
# MQTT_TLS_INSECURE=false
# MQTT_DISCOVERY_PREFIX=homeassistant
# KIOSK_ID=kiosk
# KIOSK_NAME=Pi Kiosk
# Seconds between stats publishes.
# STATS_INTERVAL=30

# Image tags (latest or a pinned version).
KIOSK_TAG=latest
LABELMAKER_TAG=latest
