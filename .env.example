# Papyrus base URL (no trailing slash, no /api/v1).
PAPYRUS_URL=http://papyrus.lan:8000
# Papyrus: Settings -> Kiosks (create a kiosk, copy its token). All other kiosk
# settings (presets, contacts, label maker, MQTT, timeouts) are edited in the admin UI
# (https://<pi-host>:8443) and stored on the Pi.
PAPYRUS_TOKEN=

# Pi address the label-maker bridge (:9177, mTLS) listens on (host/setup.sh detects it).
# Never 0.0.0.0. Use 127.0.0.1 if the label app is on this Pi.
BRIDGE_BIND=
# Admin UI bind address (optional; defaults to BRIDGE_BIND). Port 8443.
# ADMIN_BIND=
# HTTPS with a self-signed certificate by default; "off" for use behind a TLS-terminating
# reverse proxy (then keep ADMIN_BIND on 127.0.0.1 or a private network).
# ADMIN_TLS=on
# Session cookie Secure flag (default true, also behind a TLS proxy with ADMIN_TLS=off).
# Set false ONLY for a plain-HTTP LAN without a proxy, or login will not stick.
# ADMIN_COOKIE_SECURE=true
# Proxy IPs trusted for X-Forwarded-For (comma-separated; default none). Without it every
# client behind a reverse proxy shares one IP for the login rate limits.
# ADMIN_TRUSTED_PROXIES=
# Extra DNS names for the certificate, comma-separated (e.g. pi.lan).
# ADMIN_SAN_HOSTS=
# Backlight device: `ls /sys/class/backlight` (host/setup.sh detects it)
BACKLIGHT_DEVICE=
# Timezone for the kiosk clock and logs (host/setup.sh detects it).
TZ=

# Image tags (latest or a pinned version).
KIOSK_TAG=latest
LABELMAKER_TAG=latest

# Legacy overrides: only used until the first save in the admin UI (which seeds from them);
# stored settings always win afterwards.
# LABELMAKER_URL= LABELMAKER_TOKEN= IDLE_MINUTES= KIOSK_NAME= KIOSK_ID=
# SCAN_PAPERLESS= SCAN_SMB_SHARE_ID= SCAN_SMB_PATH= SCAN_CLOUD_PROVIDER_ID=
# UNLOCK_IDLE_S= UNLOCK_MAX_S= PAPYRUS_PUBLIC_URL= KIOSK_PRESETS=
# MQTT_HOST= MQTT_PORT= MQTT_USERNAME= MQTT_PASSWORD= MQTT_TLS= MQTT_CA_FILE=
# MQTT_TLS_INSECURE= MQTT_DISCOVERY_PREFIX= STATS_INTERVAL=
# SETTINGS_PATH=/var/lib/pi-kiosk/settings.json SPOOL_DIR=/var/tmp PRINT_MAX_BYTES=104857600
